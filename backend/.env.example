# Copie ce fichier en ".env" (jamais committé — déjà dans .gitignore) et
# remplis les vraies valeurs.

PORT=4000

# Origines autorisées (séparées par des virgules) à appeler cette API —
# sécurité ajoutée lors de l'audit : sans ça, n'importe quel site web pouvait
# faire des requêtes vers ton backend. En développement, la valeur par défaut
# (localhost:5173 + localhost:4000) suffit. En production, mets l'adresse
# réelle de ton site, ex. : CORS_ORIGIN=https://prononciation.mondomaine.com
CORS_ORIGIN=

# ── Base de données MySQL ───────────────────────────────────────────────────
# Il faut créer la base elle-même une fois, avant de lancer le serveur :
#   CREATE DATABASE prononciation CHARACTER SET utf8mb4;
# Le serveur crée ensuite automatiquement les tables (users, tentatives) au démarrage.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=prononciation

# ── Authentification ─────────────────────────────────────────────────────────
# Clé secrète pour signer les tokens JWT — ce n'est PAS un token à récupérer
# quelque part, c'est une valeur aléatoire que tu génères toi-même UNE FOIS
# et que tu gardes secrète (jamais committée). Génère-la avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# puis colle le résultat ici.
JWT_SECRET=

# ── Confirmation d'email ─────────────────────────────────────────────────────
# Adresse de base du FRONTEND (pas du backend) — utilisée pour construire le
# lien cliquable envoyé dans l'email de confirmation, ex. :
#   APP_URL=https://prononciation.mondomaine.com
# En développement, la valeur par défaut (http://localhost:5173) convient.
APP_URL=http://localhost:5173

# Serveur SMTP réel pour l'envoi des emails de confirmation. N'importe quel
# fournisseur SMTP standard convient : Brevo (ex-Sendinblue, offre gratuite
# généreuse), Resend, Mailgun, Amazon SES, ou même Gmail avec un "mot de
# passe d'application" (pas ton mot de passe normal). Si ces variables sont
# vides, aucun email n'est envoyé : en développement, le lien de vérification
# est simplement affiché dans la console du serveur pour pouvoir quand même
# tester le parcours complet sans compte SMTP.
#
# CHOISIS SOIT SMTP (ci-dessous) SOIT EMAILJS (bloc suivant), pas les deux —
# EmailJS est utilisé en priorité si les deux sont renseignés.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PrononciA+ <no-reply@prononcia.app>"

# Alternative à SMTP : EmailJS (dashboard.emailjs.com), pratique si tu as
# déjà un compte. Valeurs à récupérer sur ton dashboard EmailJS :
#   - EMAILJS_SERVICE_ID  → Email Services (ex. "service_xxxxxxx")
#   - EMAILJS_TEMPLATE_ID → Email Templates (ex. "template_xxxxxxx")
#   - EMAILJS_PUBLIC_KEY  → Account > General ("Public Key")
#   - EMAILJS_PRIVATE_KEY → Account > Security ("Private Key") — nécessaire
#     pour appeler leur API depuis un serveur (pas un navigateur)
# Ton template EmailJS doit utiliser les variables {{to_email}}, {{to_name}},
# {{subject}} et {{message}} — adapte ton template si besoin.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ── WhatsApp (réinitialisation de mot de passe) — optionnel ─────────────────
# Via Twilio (console.twilio.com). Sans ces variables, le code de
# réinitialisation part uniquement par email (toujours fonctionnel).
#   TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN → Console Twilio > Dashboard
#   TWILIO_WHATSAPP_FROM → numéro WhatsApp Twilio, ex. "whatsapp:+14155238886"
# ⚠️ En bac à sable (gratuit), chaque destinataire doit d'abord envoyer un
# message d'activation ("join ...") au numéro Twilio depuis WhatsApp.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Premium (paiement Mobile Money via FedaPay) ──────────────────────────────
# Clés API FedaPay (Dashboard > Réglages > Clés API sur fedapay.com).
# Utilise d'abord les clés "sandbox" pour tester avec l'opérateur de test
# `momo_test`, puis les clés "live" une fois prêt à encaisser pour de vrai.
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
# Secret de signature des webhooks (Dashboard > Réglages > Webhooks) — sert à
# vérifier qu'un appel entrant vient bien de FedaPay et pas d'un tiers.
FEDAPAY_WEBHOOK_SECRET=
# Prix de l'accès Premium à vie, en FCFA (XOF).
PREMIUM_PRICE_XOF=2000
# Nombre d'analyses de prononciation autorisées par jour pour un compte
# gratuit (illimité pour Premium/admin). Voir /api/analyze dans server.js.
FREE_DAILY_ANALYSES=15

# Emails (séparés par des virgules) automatiquement promus administrateur —
# à la création du compte s'il n'existe pas encore, ou immédiatement au
# prochain démarrage du serveur s'il existe déjà. Donne accès au tableau de
# bord admin (gestion des utilisateurs, statistiques globales).
ADMIN_EMAILS=acakpothibaut2@gmail.com

# ── Hiérarchie entre administrateurs ─────────────────────────────────────────
# Le SEUL email autorisé à gérer les autres comptes admin (changer leurs
# droits, leur Premium, ou les supprimer) — les autres admins ne peuvent pas
# se modifier entre eux, seulement gérer les comptes utilisateurs standards.
SUPER_ADMIN_EMAIL=acakpothibaut2@gmail.com

# ── Sauvegarde automatique (voir scripts/backup_db.js) ──────────────────────
# Nombre de jours de sauvegardes conservées dans backend/backups/ avant
# suppression automatique. Lance `npm run backup` manuellement, ou planifie-le
# (Planificateur de tâches Windows / cron) — instructions dans le script.
BACKUP_RETENTION_DAYS=14

# Chemin vers l'exécutable Python à utiliser pour le worker d'analyse.
PYTHON_PATH=python

# Modèle Whisper à charger (tiny.en, base.en, small.en...). "tiny.en" est le
# plus petit et le plus rapide à charger — largement suffisant pour de la
# reconnaissance de mots isolés. Un modèle plus gros serait plus précis mais
# plus lent et plus gourmand en RAM.
#
# IMPORTANT (hors-ligne) : le tout premier démarrage du serveur télécharge ce
# modèle une seule fois depuis Internet (~75 Mo pour tiny.en) et le met en
# cache localement (dossier .cache/whisper). C'est un téléchargement ponctuel
# inhérent à l'utilisation d'un modèle IA pré-entraîné — impossible à éviter
# techniquement, même si tout le reste de l'application ne nécessite ensuite
# plus jamais Internet. Une fois ce téléchargement fait, l'analyse de
# prononciation fonctionne entièrement en local, sans connexion.
WHISPER_MODEL=tiny.en

# Modèle acoustique de reconnaissance de phonèmes (analyse la vraie
# prononciation depuis l'audio, voir backend/python/acoustic_phonemes.py).
# ~1,2 Go téléchargés une seule fois au premier lancement. Ne change cette
# valeur que si tu sais ce que tu fais — un autre modèle pourrait utiliser
# un alphabet phonétique différent, incompatible avec le reste du pipeline.
ACOUSTIC_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft

# ── Optionnel : image pour les mots tapés hors des 80 objets illustrés ─────
# Les 80 objets de la galerie restent 100% locaux (aucune clé requise). Cette
# clé sert UNIQUEMENT à essayer de trouver une photo pour un mot tapé au
# clavier qui n'en fait pas partie — si absente, l'app fonctionne quand même
# normalement, juste sans image pour ces mots-là. Clé gratuite sur
# https://www.pexels.com/api/
PEXELS_API_KEY=
